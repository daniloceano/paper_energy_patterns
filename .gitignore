# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/
paper_energy_patterns/

# Jupyter
.ipynb_checkpoints/

# Data files (large binaries - don't commit to git)
data/*.parquet
data/*.csv
data/*.nc
data/*.h5
data/*.hdf5

# Exclude specific data subdirectories
data/lec_results/
data/temp_lec_zenodo
data/era5_ep1_full
data/ck_analysis/
data/era5_ep1_OLD*

# era5_ep1: exclude per-case files, keep composites
data/era5_ep1/*.nc
data/era5_ep1/*_metadata.csv
!data/era5_ep1/precomputed_composites_*.nc
data/era5_ep_structure*/era5_monthly_raw/era5_*.nc

# era5_explosive_cyclones: exclude per-case MSLP downloads (large, remote-only)
data/era5_explosive_cyclones/*.nc
data/era5_explosive_cyclones/*_metadata.csv

# era5_ep_structure: exclude per-case downloaded files (large, remote-only)
# Covers: *_era5.nc, *_era5_pressure.nc, *_era5_single.nc,
#         *_patch_*.nc, *_era5_backup.nc, and per-case metadata CSVs
data/era5_ep_structure*/*.nc
data/era5_ep_structure*/*_metadata.csv
data/era5_ep_structure/derived/*_era5_derived.nc
# Exception: keep lightweight precomputed composites generated by step 3
!data/era5_ep_structure*/precomputed_composites_*.nc

# Local test data (downloaded by fetch_test_data.sh for local smoke testing)
# These are real data files and must NOT be committed to git
data/test/

# Keep data directory structure
!data/README.md
!data/.gitkeep

# Results and figures (generated files)
# Binary figures are generated by the Python scientific pipeline.
# They are served in PRODUCTION via Supabase Storage (not Git).
# Use scripts/web/upload_figures_to_supabase.py to upload them.
# In LOCAL DEV they are read from disk via the /api/figures route (no git needed).
# See web/DEPLOYMENT.md for the full workflow.
results/**/*.csv
results/**/*.txt
results/**/*.json
figures/**/*.png
figures/**/*.jpg
figures/**/*.jpeg
figures/**/*.pdf
figures/**/*.svg
figures/**/*.gif
figures/**/*.webp

# Exclude specific results subdirectories
results/lec_results/
results/ck_analysis/lec_results

# Keep directory structure for results and figures
!results/README.md
!results/.gitkeep
!figures/README.md
!figures/.gitkeep
!results/**/.gitkeep
!figures/**/.gitkeep

# OS
.DS_Store
Thumbs.db
._*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Pipeline logs (generated at runtime, never commit)
logs/

# Temporary files
*.tmp
*.bak
*.log
*.out


# Distribution / packaging
dist/
build/
*.egg-info/

# Web (Next.js)
web/node_modules/
web/.next/
web/.env.local
# Content JSONs must be committed for Vercel build (they're read at static-gen time)
# Do NOT add web/src/content/*.json here

# Generated analysis figures served via Supabase Storage (not git)
# Upload with: python scripts/web/upload_figures_to_supabase.py --dirs ck_subterms cyclone_explorer
web/public/figures/ck_subterms/
web/public/figures/cyclone_explorer/

# Website secret keys
data/era5_ep_structure_legacy/19790079_metadata.csv

# cps_analysis: generated inputs/outputs (regenerable from ERA5 + tracks)
# Keep only the two calculator/plotting scripts under version control.
scripts/cps_analysis/cyclone_tracks/
scripts/cps_analysis/csv_output/
scripts/cps_analysis/cps_output/
