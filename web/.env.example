# Supabase connection (database + auth)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase Storage — public base URL for the 'figures' bucket.
# Format: https://<project-ref>.supabase.co/storage/v1/object/public/figures
# If this is set, all figures are served from Supabase Storage (production mode).
# If NOT set, figures are served via /api/figures from the local filesystem (dev mode).
NEXT_PUBLIC_SUPABASE_FIGURES_URL=https://<project-ref>.supabase.co/storage/v1/object/public/figures

# Site metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
