# Results and figures (generated files)
results/**/*.csv
results/**/*.txt
results/**/*.json
figures/**/*.png
figures/**/*.jpg
figures/**/*.pdf
figures/**/*.svg

# Keep directory structure for results and figures
!results/README.md
!results/.gitkeep
!figures/README.md
!figures/.gitkeep
!results/**/.gitkeep
!figures/**/.gitkeep

