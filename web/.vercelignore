# Exclude large data directories and figures
# These bloat serverless functions and aren't needed at runtime

# Large figure directories
public/figures/
public/docs/

# Data directories (not needed for web deployment)
data/
logs/
results/

# Repository scripts and notebooks
scripts/

# Legacy/exploratory files
docs/legacy/
figures/exploratory/

# Node modules and build artifacts (handled by Vercel)
node_modules/
.next/

# Development files
.env.local
.env.*.local

# Version control
.git/
.gitignore
