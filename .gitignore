# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/
paper_energy_patterns/

# Jupyter
.ipynb_checkpoints/

# Data files (large binaries - don't commit to git)
data/*.parquet
data/*.csv
data/*.nc
data/*.h5
data/*.hdf5

# Exclude specific data subdirectories
data/lec_results/
data/temp_lec_zenodo
data/era5_ep1_full
data/ck_analysis/
data/era5_ep1_OLD*

# era5_ep1: exclude per-case files, keep composites
data/era5_ep1/*.nc
data/era5_ep1/*_metadata.csv
!data/era5_ep1/precomputed_composites_*.nc
data/era5_ep_structure/era5_monthly_raw/era5_*.nc

# era5_ep_structure: exclude per-case downloaded files (large, remote-only)
# Covers: *_era5.nc, *_era5_pressure.nc, *_era5_single.nc,
#         *_patch_*.nc, *_era5_backup.nc, and per-case metadata CSVs
data/era5_ep_structure/*.nc
data/era5_ep_structure/*_metadata.csv
# Exception: keep lightweight precomputed composites generated by step 3
!data/era5_ep_structure/precomputed_composites_*.nc

# Keep data directory structure
!data/README.md
!data/.gitkeep

# Results and figures (generated files)
results/**/*.csv
results/**/*.txt
results/**/*.json
# Keep all PNG/SVG/PDF figures committed — the web layer on Vercel needs them
# (Figures are generated by Python scripts; they are small enough to commit)

# Exclude specific results subdirectories
results/lec_results/
results/ck_analysis/lec_results

# Keep directory structure for results and figures
!results/README.md
!results/.gitkeep
!figures/README.md
!figures/.gitkeep
!results/**/.gitkeep
!figures/**/.gitkeep

# OS
.DS_Store
Thumbs.db
._*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak
*.log
*.out


# Distribution / packaging
dist/
build/
*.egg-info/

# Web (Next.js)
web/node_modules/
web/.next/
web/.env.local
# Content JSONs must be committed for Vercel build (they're read at static-gen time)
# Do NOT add web/src/content/*.json here

# Allow ep_structure composite figures (step4 output — publication figures)
!figures/ep_structure/
!figures/ep_structure/*.png
